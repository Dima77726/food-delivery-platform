<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Самостоятельный pom, без родителя платформы — намеренно. Контракт публикуется
        и подключается отдельно от сервисов, и потребитель не должен тянуть за ним родительский
        pom монолита со всеми его версиями. В общей сборке модуль участвует как модуль
        агрегатора, но ничего от него не наследует.
    -->
    <groupId>com.dima</groupId>
    <artifactId>grpc-contracts</artifactId>
    <!-- Своя версия контрактов; её же указывает contracts.version в pom платформы. -->
    <version>1.0.0-SNAPSHOT</version>
    <name>grpc-contracts</name>
    <description>Контракты синхронных вызовов между сервисами: .proto и сгенерированные из них стабы</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Версии совпадают с теми, что берёт Spring gRPC в сервисах: см. pom платформы. -->
        <spring-grpc.version>1.0.3</spring-grpc.version>
        <grpc.version>1.77.1</grpc.version>
        <protobuf-java.version>4.33.4</protobuf-java.version>
        <protobuf-maven-plugin.version>5.1.11</protobuf-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.grpc</groupId>
                <artifactId>spring-grpc-dependencies</artifactId>
                <version>${spring-grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf-java.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
        Источник истины — файлы .proto в src/main/proto. Java-код целиком генерируется
        на этапе generate-sources, рукописного кода в модуле нет и быть не должно: тогда
        контракт и его Java-представление не могут разойтись.

        Почему стабы собираются здесь, а не в каждом сервисе из общего каталога .proto.
        Так все стороны гарантированно используют один и тот же сгенерированный код одной
        версией protoc. Сгенерируй каждый сервис стабы сам, и клиент со старым плагином
        однажды разошёлся бы с сервером на новом — без единой ошибки компиляции.

        Зависимости — только рантайм gRPC и protobuf, без Spring. Каким способом сервис
        поднимает сервер или канал, решает сам сервис.
    -->

    <dependencies>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
        </dependency>

        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
        </dependency>

        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                protoc и плагин grpc-java скачиваются из Maven Central под текущую платформу:
                ставить их в систему не нужно, и версия у всех разработчиков и в CI одна.
                Версии берутся из BOM spring-grpc, чтобы сгенерированный код совпадал
                с рантаймом, который подтягивает Spring gRPC в сервисах.
            -->
            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <version>${protobuf-maven-plugin.version}</version>
                <configuration>
                    <protoc kind="binary-maven">
                        <version>${protobuf-java.version}</version>
                    </protoc>
                    <plugins>
                        <plugin kind="binary-maven">
                            <groupId>io.grpc</groupId>
                            <artifactId>protoc-gen-grpc-java</artifactId>
                            <version>${grpc.version}</version>
                        </plugin>
                    </plugins>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/Dima77726/food-delivery-platform</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/Dima77726/food-delivery-platform</url>
        </snapshotRepository>
    </distributionManagement>

</project>
