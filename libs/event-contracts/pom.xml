<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Самостоятельный pom, без родителя платформы — намеренно. Контракт публикуется
        и подключается отдельно от сервисов, и потребитель не должен тянуть за ним родительский
        pom монолита со всеми его версиями. В общей сборке модуль участвует как модуль
        агрегатора, но ничего от него не наследует.
    -->
    <groupId>com.dima</groupId>
    <artifactId>event-contracts</artifactId>
    <!-- Своя версия контрактов; её же указывает contracts.version в pom платформы. -->
    <version>1.0.0-SNAPSHOT</version>
    <name>event-contracts</name>
    <description>Контракты событий, которыми сервисы обмениваются через Kafka</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!--
        Библиотека контрактов: формы сообщений и имена топиков, и больше ничего.

        Зависимостей нет ни одной, и это правило, а не случайность. Контракт подключают
        все сервисы, и любая зависимость отсюда навязывалась бы каждому из них — вплоть
        до конфликта версий Spring в сервисе, который обновляется по своему графику.
        Записи Java сериализуются Jackson без единой аннотации, так что обходиться
        без зависимостей получается без жертв.

        Логики здесь тоже не должно появляться. Общая библиотека с кодом — это
        распределённый монолит: правка в ней требует синхронного релиза всех сервисов,
        то есть отнимает ровно ту независимость, ради которой их разделяли.
    -->

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/Dima77726/food-delivery-platform</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/Dima77726/food-delivery-platform</url>
        </snapshotRepository>
    </distributionManagement>

</project>
