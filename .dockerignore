# Что не попадает в контекст сборки образа.
#
# Контекст целиком уходит демону Docker при каждой сборке. Без этого файла туда ехали бы
# .env с паролями, история git и все каталоги target — сотни мегабайт, которые образу
# не нужны, а .env в контексте — это секреты там, где их никто не ждёт.

.env
.git
.idea
.claude
**/target
observability
postman
docker
