<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Родительский pom реактора.

        Платформа переезжает с модульного монолита на микросервисы — постепенно,
        по шаблону strangler fig: сервисы по одному выносятся из монолита, а он продолжает
        работать и обслуживать всё, что ещё не вынесено. Отсюда состав модулей:

          service              — монолит (core): всё, что ещё не вынесено;
          notification-service — уведомления, первый вынесенный сервис;
          api-gateway          — единая точка входа, маршрутизирует запросы по сервисам;
          libs/event-contracts — контракты событий Kafka, общие для продюсера и потребителей;
          client               — типизированный Java-клиент к API, отдельный артефакт.

        Монорепозиторий здесь — решение про удобство, а не про связность. Сервисы
        не зависят друг от друга ни одной строкой кода: общее у них — только контракты
        событий и HTTP API. Каждый собирается в свой образ и запускается отдельно.

        Источник истины для REST API — openapi/food-delivery-api.yaml в корне.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.5</version>
        <relativePath/>
    </parent>

    <groupId>com.dima</groupId>
    <artifactId>food-delivery-platform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>food-delivery-platform</name>
    <description>Платформа доставки еды: монолит и выносимые из него сервисы</description>

    <modules>
        <module>libs/event-contracts</module>
        <module>service</module>
        <module>notification-service</module>
        <module>api-gateway</module>
        <module>client</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- Ветка 3.x springdoc — единственная, совместимая со Spring Boot 4 / Framework 7. -->
        <springdoc.version>3.1.0</springdoc.version>
        <openapi-generator.version>7.24.0</openapi-generator.version>
        <!-- ClickHouse не входит в spring-boot-dependencies: версию держим здесь. -->
        <clickhouse-jdbc.version>0.9.9</clickhouse-jdbc.version>
        <!--
            Релизный поезд Spring Cloud под Spring Boot 4.0. Нужен только шлюзу, но версия
            держится здесь: следующие сервисы (discovery, config, resilience) возьмут ту же.
        -->
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <!--
            Путь к спецификации. Оба модуля ссылаются на один файл, иначе контракт сервера
            и контракт клиента разъехались бы уже на второй правке.

            project.parent.basedir, а не maven.multiModuleProjectDirectory: второе
            выставляется скриптом-обёрткой и не определено при запуске через голый mvn.
        -->
        <openapi.spec>${project.parent.basedir}/openapi/food-delivery-api.yaml</openapi.spec>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.dima</groupId>
                <artifactId>event-contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.openapitools</groupId>
                    <artifactId>openapi-generator-maven-plugin</artifactId>
                    <version>${openapi-generator.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
