<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Родительский pom реактора.

        Модулей два, и разделены они по потребителю, а не по слоям:
          service — само приложение;
          client  — типизированный Java-клиент к нему, отдельный артефакт.

        Смысл разделения в том, что клиента можно отдать потребителю API, не отдавая ему
        приложение целиком со всеми его зависимостями на базу, Liquibase и Security.
        Пока оба модуля лежат в одном репозитории, но собираются и версионируются
        независимо друг от друга.

        Источник истины для обоих — openapi/food-delivery-api.yaml в корне.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.5</version>
        <relativePath/>
    </parent>

    <groupId>com.dima</groupId>
    <artifactId>food-delivery-platform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>food-delivery-platform</name>
    <description>Модульный монолит доставки еды</description>

    <modules>
        <module>service</module>
        <module>client</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <!-- Ветка 3.x springdoc — единственная, совместимая со Spring Boot 4 / Framework 7. -->
        <springdoc.version>3.1.0</springdoc.version>
        <openapi-generator.version>7.24.0</openapi-generator.version>
        <!-- ClickHouse не входит в spring-boot-dependencies: версию держим здесь. -->
        <clickhouse-jdbc.version>0.9.9</clickhouse-jdbc.version>
        <!--
            Путь к спецификации. Оба модуля ссылаются на один файл, иначе контракт сервера
            и контракт клиента разъехались бы уже на второй правке.

            project.parent.basedir, а не maven.multiModuleProjectDirectory: второе
            выставляется скриптом-обёрткой и не определено при запуске через голый mvn.
        -->
        <openapi.spec>${project.parent.basedir}/openapi/food-delivery-api.yaml</openapi.spec>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.openapitools</groupId>
                    <artifactId>openapi-generator-maven-plugin</artifactId>
                    <version>${openapi-generator.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
