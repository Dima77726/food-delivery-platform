            "type": "grafana-postgresql-datasource",
            "uid": "pg-orders"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT i.menu_item_name AS \"блюдо\", sum(i.quantity) AS \"порций\", sum(i.line_total) AS \"выручка\" FROM customer_order_item i JOIN customer_order o ON o.id = i.order_id WHERE o.status NOT IN ('CREATED','PAYMENT_PENDING','CANCELED') GROUP BY 1 ORDER BY 2 DESC LIMIT 10",
          "format": "table"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
