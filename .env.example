# Образец окружения для docker compose. Скопируйте в .env и при желании поправьте:
#
#   cp .env.example .env
#
# Сам .env в репозиторий не попадает — он в .gitignore. Здесь лежат только значения,
# пригодные для локальной разработки; ничего из этого нельзя переносить в боевой стенд.

# --- PostgreSQL ---------------------------------------------------------------------------
# Значения обязательные: в docker-compose.yml у них нет значений по умолчанию,
# и без .env контейнер базы поднимется с пустыми параметрами.
POSTGRES_DB=food_delivery
POSTGRES_USER=food_user
POSTGRES_PASSWORD=food_password
POSTGRES_PORT=5432

# Часовой пояс контейнеров. На метки времени в базе не влияет — они хранятся
# в timestamptz, — но делает логи читаемыми.
TZ=Europe/Moscow

# --- Схемы ---------------------------------------------------------------------------------
# APP_SCHEMA — схема приложения, LIQUIBASE_SCHEMA — схема со служебными таблицами
# журнала миграций. Разделены намеренно: служебным таблицам нечего делать
# рядом с прикладными.
APP_SCHEMA=food_app
LIQUIBASE_SCHEMA=liquibase_meta

# --- Необязательное ------------------------------------------------------------------------
# Порты остальных сервисов имеют значения по умолчанию в docker-compose.yml,
# раскомментируйте только если нужные порты уже заняты.
#REDIS_PORT=6379
#KAFKA_PORT=9094
#KAFKA_UI_PORT=8090
#APP_PORT=8080
#PROMETHEUS_PORT=9090
#GRAFANA_PORT=3000

# Ключ подписи JWT. Не задан — приложение возьмёт dev-значение и предупредит в логе.
# Под любым профилем, кроме dev и test, JwtSecretValidator со значением по умолчанию
# стартовать не даст.
#JWT_SECRET=

# Первый администратор. Пока обе переменные пусты, учётная запись не создаётся вовсе:
# роль ADMIN через регистрацию не выдаётся, и другого способа её получить нет.
#APP_ADMIN_EMAIL=
#APP_ADMIN_PASSWORD=
