# Образец окружения для docker compose. Скопируйте в .env и при желании поправьте:
#
#   cp .env.example .env
#
# Сам .env в репозиторий не попадает — он в .gitignore.
#
# Ни одного настоящего пароля здесь нет и быть не должно: вместо значений стоят
# заглушки change-me-*. Замените их в своём .env — хоть на те же строки, хоть
# на случайные, но решение об этом принимается вне репозитория.
#
# Учётные данные не имеют значений по умолчанию ни в application.yml, ни
# в docker-compose.yml. Забытая переменная — это остановка на старте с её именем
# в сообщении, а не молчаливый вход под чужим паролем.

# --- PostgreSQL ---------------------------------------------------------------------------
# Значения обязательные: в docker-compose.yml у них нет значений по умолчанию,
# и без .env контейнер базы поднимется с пустыми параметрами.
POSTGRES_DB=food_delivery
POSTGRES_USER=food_user
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432

# Часовой пояс контейнеров. На метки времени в базе не влияет — они хранятся
# в timestamptz, — но делает логи читаемыми.
TZ=Europe/Moscow

# --- Базы сервисов -------------------------------------------------------------------------
# У каждого вынесенного сервиса своя база и своя учётная запись (database-per-service).
# Создаёт их одноразовый контейнер postgres-provision при каждом docker compose up —
# подробности в docker/postgres/provision-service-databases.sh. Пароль можно поменять
# здесь в любой момент: при следующем up он будет применён к существующей учётной записи.
NOTIFICATION_DB_USER=notification_service
NOTIFICATION_DB_PASSWORD=change-me-notification-db
#NOTIFICATION_DB_NAME=notification

CATALOG_DB_USER=catalog_service
CATALOG_DB_PASSWORD=change-me-catalog-db
#CATALOG_DB_NAME=catalog

IDENTITY_DB_USER=identity_service
IDENTITY_DB_PASSWORD=change-me-identity-db
#IDENTITY_DB_NAME=identity

ORDER_DB_USER=order_service
ORDER_DB_PASSWORD=change-me-order-db
#ORDER_DB_NAME=orders

PAYMENT_DB_USER=payment_service
PAYMENT_DB_PASSWORD=change-me-payment-db
#PAYMENT_DB_NAME=payments

# Платёжный шлюз payment-service: simulated (заглушка) или stripe. Для stripe нужен тестовый
# ключ из Stripe Dashboard → Developers → API keys (sk_test_…); он ничего не списывает по-настоящему.
# Ключ не коммитьте. Рубли Stripe на новых аккаунтах не принимает, поэтому валюта по умолчанию usd.
#PAYMENT_GATEWAY=simulated
#STRIPE_API_KEY=sk_test_change-me
#STRIPE_CURRENCY=usd
# Пересчитывать сумму заказа (рубли) в валюту провайдера по курсу ЦБ РФ (SOAP-клиент); нужен выход в интернет.
#FX_ENABLED=false
# Входящие вебхуки Stripe: секрет конечной точки (Stripe Dashboard → Developers → Webhooks или вывод
# `stripe listen --forward-to localhost:8080/api/v1/webhooks/stripe`). Работает и с симулированным шлюзом.
#STRIPE_WEBHOOK_SECRET=whsec_change-me

# Хранилище фото блюд (MinIO). Это и учётная запись консоли http://localhost:9001, и ключи,
# с которыми каталог пишет в бакет. Пароль не короче 8 символов; смените оба значения.
# MEDIA_ENABLED=false выключает загрузку фото (каталог ответит 503, остальное работает).
MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-minio-password
#MINIO_CONSOLE_PORT=9001
#MEDIA_ENABLED=true

# Keycloak (профиль auth: docker compose --profile full --profile auth up -d). Консоль - http://localhost:8180.
# Пароль администратора задайте свой; OIDC_ENABLED=true включает вход через Keycloak в identity-service.
#KEYCLOAK_ADMIN=admin
#KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
#KEYCLOAK_PORT=8180
#OIDC_ENABLED=false

# Учётная запись PostgreSQL только для чтения: Grafana и ручной анализ (DataGrip). Без пароля не заводится.
#ANALYTICS_DB_USER=analytics_reader
ANALYTICS_DB_PASSWORD=change-me-analytics-reader
#KIBANA_PORT=5601

# Почта (notification-service). В compose письма принимает Mailpit — http://localhost:8025, —
# наружу ничего не уходит. EMAIL_ENABLED=false возвращает отправку «в лог».
#EMAIL_ENABLED=true
#EMAIL_FROM=no-reply@food-delivery.local
# Настоящий SMTP-провайдер: MAIL_HOST/MAIL_PORT и, для сервисов с логином, MAIL_USER/MAIL_PASSWORD,
# MAIL_AUTH=true и MAIL_STARTTLS=true (в compose они не пробрасываются — добавьте при необходимости).
#MAIL_HOST=mailpit
#MAIL_PORT=1025

# Уведомления в Telegram (notification-service). Бота создаёт @BotFather командой /newbot: он выдаёт
# токен и имя. Токен — секрет, не коммитьте. Пользователь подключает чат ссылкой из
# POST /api/v1/notifications/telegram/link. Опрос бота ведёт один экземпляр сервиса.
#TELEGRAM_ENABLED=true
#TELEGRAM_BOT_TOKEN=123456:change-me
#TELEGRAM_BOT_USERNAME=my_food_delivery_bot
# Режим бота: polling (по умолчанию, работает локально) или webhook (нужен публичный https-адрес шлюза,
# например туннель). Секрет — 1–256 символов A-Z a-z 0-9 _ -.
#TELEGRAM_MODE=webhook
#TELEGRAM_WEBHOOK_PUBLIC_URL=https://example.ngrok.app
#TELEGRAM_WEBHOOK_SECRET=change-me

# Исходящие вебхуки ресторанов (notification-service): ключ шифрования секретов подписок в базе.
# Без него вебхуки выключены (API отвечает 503). Сгенерировать: openssl rand -base64 32
#WEBHOOK_SECRET_KEY=

# Web Push (notification-service): пара ключей VAPID (P-256, Base64url). Без неё push выключен.
# Сгенерировать: docker run --rm node:22-alpine npx -y web-push generate-vapid-keys
#WEB_PUSH_VAPID_PUBLIC_KEY=
#WEB_PUSH_VAPID_PRIVATE_KEY=
#WEB_PUSH_SUBJECT=mailto:you@example.com

# CDC (профиль cdc, ./scripts/start.ps1 -Cdc): пароль учётки Debezium с правом репликации базы заказов.
#DEBEZIUM_DB_PASSWORD=change-me
# MQTT для устройств курьеров (порт на этом компьютере).
#MQTT_PORT=1883

# --- Схемы ---------------------------------------------------------------------------------
# APP_SCHEMA — схема приложения, LIQUIBASE_SCHEMA — схема со служебными таблицами
# журнала миграций. Разделены намеренно: служебным таблицам нечего делать
# рядом с прикладными.
APP_SCHEMA=food_app
LIQUIBASE_SCHEMA=liquibase_meta

# --- Необязательное ------------------------------------------------------------------------
# Порты остальных сервисов имеют значения по умолчанию в docker-compose.yml,
# раскомментируйте только если нужные порты уже заняты.
#REDIS_PORT=6379
#KAFKA_PORT=9094
#RABBITMQ_PORT=5672
#RABBITMQ_UI_PORT=15672
#KAFKA_UI_PORT=8090
#APP_PORT=8080
#PROMETHEUS_PORT=9090
#GRAFANA_PORT=3000

# --- Обязательные секреты ------------------------------------------------------------------
# Закрытый RSA-ключ подписи токенов — только для identity-service. Остальные сервисы
# проверяют токены открытым ключом из его JWKS, и подделать токен им нечем.
# Формат — PKCS#8 DER в Base64 одной строкой. Значения по умолчанию нет: без ключа сервис
# пользователей не стартует. Сгенерировать:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 -w0
JWT_PRIVATE_KEY=change-me-base64-pkcs8-rsa-private-key
# Идентификатор ключа (kid). При смене ключа меняйте и его — так проверяющие сразу поймут,
# что ключ новый, и перечитают JWKS.
JWT_KEY_ID=key-1
# Сроки жизни токенов (ISO-8601). Access-токен отозвать нельзя, поэтому он короткий;
# сессию держит refresh-токен, срок которого отсчитывается заново при каждом обмене.
#JWT_ACCESS_TOKEN_TTL=PT15M
#JWT_REFRESH_TOKEN_TTL=P30D

# Сколько заказ ждёт оплаты (ISO-8601), прежде чем отмениться сам. Если оплату уже запросили,
# при отмене сервису платежей уходит команда на возврат.
#PAYMENT_TIMEOUT=PT15M

# Учётная запись RabbitMQ: её создаёт сам брокер при первом старте, ею же ходит
# notification-service. Интерфейс управления — http://localhost:15672.
RABBITMQ_USER=food_delivery
RABBITMQ_PASSWORD=change-me-rabbitmq

# Пароль администратора Grafana (логин admin). Без переменной docker compose
# останавливается и называет её.
GRAFANA_PASSWORD=change-me-grafana

# Первый администратор приложения. Пока обе переменные пусты, учётная запись не создаётся
# вовсе: роль ADMIN через регистрацию не выдаётся, и другого способа её получить нет.
# Это единственная пара, где пустое значение осмысленно, — оно означает «администратора нет».
#APP_ADMIN_EMAIL=admin@example.com
#APP_ADMIN_PASSWORD=change-me-admin

# --- Пять дополнительных хранилищ ----------------------------------------------------------
# MongoDB (отзывы), Cassandra (трек курьера), Neo4j (рекомендации), ClickHouse (аналитика)
# и Elasticsearch (поиск). По умолчанию выключены все пять, и приложение работает ровно так,
# как работало до их появления.
#
# Включение состоит из двух шагов, и оба обязательны:
#
#   1. поднять контейнеры:  docker compose --profile stores up -d
#   2. снять комментарий с нужных строк ниже и перезапустить приложение
#
# Порядок именно такой: включённый модуль требует доступного сервера и на старте создаёт
# в нём свою схему. Если сервера нет, приложение не поднимется — это сделано намеренно,
# чтобы наполовину рабочий API не обнаружился уже в проде.
#
# Вместе пять контейнеров занимают около пяти гигабайт памяти. Включать их все сразу
# не обязательно: выключатели независимы.

#STORE_MONGO_ENABLED=true
#STORE_NEO4J_ENABLED=true
#STORE_CLICKHOUSE_ENABLED=true
#STORE_ELASTICSEARCH_ENABLED=true

# Учётная запись Neo4j. Обязательна при STORE_NEO4J_ENABLED=true: и контейнер, и приложение
# берут её отсюда, значений по умолчанию нет ни там, ни там. Меняя пароль у поднятого
# контейнера, пересоздайте его — существующий пароль хранится в томе с данными.
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-neo4j

# База ClickHouse создаётся контейнером при первом запуске. Меняя имя здесь,
# не забудьте удалить том: существующий контейнер базу не переименует.
#CLICKHOUSE_DB=food_delivery

# Учётная запись ClickHouse. Обязательна при STORE_CLICKHOUSE_ENABLED=true.
# Пользователя default задавать нельзя: скрипт образа пытается создать уже существующего
# и падает. А без явной учётной записи образ закрывает сетевой доступ для default,
# и приложение получает «Authentication failed» вместо соединения.
CLICKHOUSE_USER=food_user
CLICKHOUSE_PASSWORD=change-me-clickhouse

# Порты. Значения по умолчанию заданы в docker-compose.yml, раскомментируйте
# только если нужные порты уже заняты.
#MONGO_PORT=27017
#CASSANDRA_PORT=9042
#NEO4J_HTTP_PORT=7474
#NEO4J_BOLT_PORT=7687
#CLICKHOUSE_PORT=8123
#ELASTIC_PORT=9200

# ---------- Мессенджер (docs/messenger) ----------
# Пароль базы мессенджера: без него база не создаётся и messenger-service не стартует.
MESSENGER_DB_PASSWORD=change-me-messenger-db
# Ключ подписи коротких ссылок на вложения (любая длинная случайная строка).
ATTACHMENTS_LINK_SECRET=change-me-attachments-link
# Адрес веб-интерфейса для ссылок «Открыть чат» в Telegram.
MESSENGER_PUBLIC_URL=http://localhost:8070
# Настоящие уведомления мессенджера в Telegram — только этим пользователям (через запятую). Пусто — всем привязавшим.
TELEGRAM_MESSENGER_ALLOWED_USER_IDS=
# Звонки вне одной сети: STUN и TURN (coturn, --profile turn).
CALLS_STUN_URLS=
CALLS_TURN_URLS=
TURN_SECRET=
TURN_EXTERNAL_IP=
